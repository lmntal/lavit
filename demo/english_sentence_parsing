count(-1).

{'$callback'(zerostep).
input(Y), '.'({$p}, X, Y), count(-1) :-
input(Y), '.'({$p, x}, X, Y), count(0).

'.'({$p, x}, X, Y), '.'({$q}, Z, X), count(A) :-
int(A), B = A + 1|
'.'({$p, index(A, B)}, X, Y),
'.'({$q, x}, Z, X), count(B).

'.'({$p, x}, X, Y), '[]'(X), count(C) :-
int(C)|
'.'({$p}, X, Y), '[]'(X).
}.

