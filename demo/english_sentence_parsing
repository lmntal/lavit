'.'(X2,X3,X1),'.'(L2,X4,X3),'.'(X5,X6,X4),
{v(L1), past, $p[L1], index(I1,I2), +L2} :-
	int(I1),int(I2)|
	'.'(X2,X3,X1),'.'(NL1,NL2,X3),
	'.'(L2,X4,NL2),'.'(X5,X6,X4),
	{t, past, index(I1,I1),+NL1},
	{v(L1), $p[L1], index(I1,I2), +L2}.
	
'.'(X2,X3,X1),'.'(L2,X4,X3),'.'(X5,X6,X4),
{v(L1), present, $p[L1], index(I1,I2), +L2} :-
	int(I1),int(I2)|
	'.'(X2,X3,X1),'.'(NL1,NL2,X3),
	'.'(L2,X4,NL2),'.'(X5,X6,X4),
	{t, present, index(I1,I1), +NL1},
	{v(L1), $p[L1], index(I1,I2), +L2}.
	
'.'(L2,L3,L1),'.'(L4,L5,L3),
{t, $p, index(X1,X2), +L2},{t, $q, index(X3,X4), +L4} :-
	int(X1), int(X2), int(X3), int(X4), 
	X2 = X3 ,X3 = X4|
	'.'(L2,L5,L1),
	{t, $p, $q, index(X1,X2), +L2}.
	
input(L1),'.'(L2,L3,L1),
'.'(L5,L6,L4),{"?"(q),question,+L5} :-                                               
	input(L1),'.'(NL1,NL2,L1),{op_ynq,index(0,0),+NL1},
	'.'(L2,L3,NL2),
	'.'(L5,L6,L4),{"?"(q),+L5}.

'.'(L2,L3,L1),{+L2,op_ynq,index(0,0),$p},
'.'(L4,L5,L3),{+L4,wh(L6),$q[L6]} :-
	'.'(L4,L5,L1),{+L4,wh(L6),$p,$q[L6]}.

