
s.
p{state(idle), hold(false), parent(X0),s(X2), s(X3), incs(false), def(false) },
p{state(idle), hold(false), parent(X1), incs(false), def(false) },
p{state(idle), hold(true), token, parent(),s(X1),s(X0), incs(false), def(false)}.
p{state(idle), hold(false), parent(X2), incs(false), def(false) }.
p{state(idle), hold(false), parent(X3), incs(false), def(false) }.

